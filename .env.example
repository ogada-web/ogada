# 로컬 앱 설정 예시. 실제 비밀은 Git에 넣지 않습니다.
# Spring Boot 실행 셸에 주입; Vite는 루트 .env의 VITE_*만 브라우저에 노출.
DB_URL=jdbc:postgresql://localhost:5432/ogada
DB_USERNAME=ogada
DB_PASSWORD=
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

PII_ENCRYPTION_KEY=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
QR_TOKEN_SECRET=

# JS 키는 웹 플랫폼 도메인 등록, REST 키는 서버에만 주입.
VITE_KAKAO_MAP_JS_KEY=
KAKAO_REST_KEY=
VITE_PROXY_TARGET=http://127.0.0.1:8080
