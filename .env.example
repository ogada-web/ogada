# Cursor SDK를 통해 Grok을 실행합니다. xAI API 키와는 별개입니다.
CURSOR_API_KEY=

# doctor --list-models에서 현재 계정의 Grok ID를 확인한 뒤 설정하세요.
# 설정하면 모든 역할이 이 모델만 사용하며 다른 모델로 자동 전환하지 않습니다.
AGENT_MODEL=

# 1: 기존 자동 push 정책. GitHub 인증이 없는 환경은 0으로 로컬 커밋만 보존.
AGENT_AUTO_PUSH=1

# 0: 실백엔드 E2E 수행(기동된 API/DB 필요). 1: 로컬 개발 루프에서 별도 운영 게이트로 남김.
AGENT_SKIP_LIVE_E2E=0
