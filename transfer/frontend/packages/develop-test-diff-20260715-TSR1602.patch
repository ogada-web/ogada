@@ -23,6 +23,54 @@ export const LINKAGE_SUMMARY_MAX = 5000;
 export const LINKAGE_TARGET_INSTITUTION_MAX = 200;
 
 const CARE_PLAN_SECTION_MARKER = "[퇴소 후 이용계획]";
+const RECORD_DATE_SECTION_MARKER = "[작성일]";
+const RECORD_DATE_LINE_RE = new RegExp(
+  `^\\s*${RECORD_DATE_SECTION_MARKER.replace(/[[\]]/g, "\\$&")}\\s+(\\d{4}-\\d{2}-\\d{2})\\s*$`,
+  "m"
+);
+
+/**
+ * Unfolds FE fold markers written by {@link buildLinkageRecordWritePayload}
+ * so draft edit rehydrates 작성일 / 본문 요약 / 퇴소 후 이용계획 without
+ * duplicating markers on the next save.
+ *
+ * @param {string|null|undefined} foldedSummary
+ * @returns {{
+ *   recordDate: string,
+ *   summary: string,
+ *   carePlanAfterDischarge: string
+ * }}
+ */
+export function parseLinkageSummaryFold(foldedSummary) {
+  const raw = String(foldedSummary || "").trim();
+  if (!raw) {
+    return { recordDate: "", summary: "", carePlanAfterDischarge: "" };
+  }
+
+  let working = raw;
+  let recordDate = "";
+  const dateMatch = working.match(RECORD_DATE_LINE_RE);
+  if (dateMatch) {
+    recordDate = dateMatch[1];
+    working = working.replace(dateMatch[0], "").trim();
+  }
+
+  let carePlanAfterDischarge = "";
+  const markerIndex = working.indexOf(CARE_PLAN_SECTION_MARKER);
+  if (markerIndex >= 0) {
+    carePlanAfterDischarge = working
+      .slice(markerIndex + CARE_PLAN_SECTION_MARKER.length)
+      .replace(/^\s*\n?/, "")
+      .trim();
+    working = working.slice(0, markerIndex).trim();
+  }
+
+  return {
+    recordDate,
+    summary: working,
+    carePlanAfterDischarge
+  };
+}
 
 /**
  * @param {string|null|undefined} code
@@ -64,6 +112,27 @@ export function resolveLinkageTimestampParts(value) {
  * }} form
  * @returns {{ linkageType: string, targetInstitution: string, summary: string }}
  */
+/**
+ * @param {Parameters<typeof buildLinkageRecordWritePayload>[0]} form
+ * @returns {boolean}
+ */
+export function isLinkageSummaryTooLong(form = {}) {
+  const parts = [];
+  const recordDate = String(form.recordDate || "").trim();
+  if (recordDate) {
+    parts.push(`[작성일] ${recordDate}`);
+  }
+  const summaryCore = String(form.summary || "").trim();
+  if (summaryCore) {
+    parts.push(summaryCore);
+  }
+  const carePlan = String(form.carePlanAfterDischarge || "").trim();
+  if (carePlan) {
+    parts.push(`${CARE_PLAN_SECTION_MARKER}\n${carePlan}`);
+  }
+  return parts.join("\n\n").length > LINKAGE_SUMMARY_MAX;
+}
