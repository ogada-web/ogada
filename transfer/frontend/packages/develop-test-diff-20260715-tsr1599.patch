+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it, vi } from "vitest";
+import ClientLinkageRecordForm from "./ClientLinkageRecordForm";
+
+describe("ClientLinkageRecordForm (G-LINKAGE-RECORD shell)", () => {
+  it("requires institution and summary before save", async () => {
+    const user = userEvent.setup();
+    const onSubmit = vi.fn();
+    render(<ClientLinkageRecordForm onSubmit={onSubmit} />);
+
+    expect(
+      screen.getByRole("heading", { name: "연계기록지 작성" })
+    ).toBeInTheDocument();
+    expect(screen.getByRole("form", { name: "연계기록지 작성" })).toBeInTheDocument();
+
+    await user.click(screen.getByRole("button", { name: "초안 저장" }));
+
+    expect(screen.getByText("연계 대상 기관명을 입력하세요.")).toBeInTheDocument();
+    expect(
+      screen.getByText("심신기능·제공 급여 요약을 입력하세요.")
+    ).toBeInTheDocument();
+    expect(onSubmit).not.toHaveBeenCalled();
+  });
+
+  it("submits DRAFT payload and announces success", async () => {
+    const user = userEvent.setup();
+    const onSubmit = vi.fn().mockResolvedValue(undefined);
+    render(
+      <ClientLinkageRecordForm clientName="홍길동" onSubmit={onSubmit} />
+    );
+
+    expect(
+      screen.getByRole("heading", { name: "연계기록지 작성 — 홍길동" })
+    ).toBeInTheDocument();
+
+    await user.type(screen.getByLabelText(/연계 대상 기관/), "서울요양병원");
+    await user.type(
+      screen.getByLabelText(/심신기능·제공 급여 요약/),
+      "주간보호 이용 중 · 외래 진료 의"
+    );
+    await user.click(screen.getByRole("button", { name: "초안 저장" }));
+
+    expect(onSubmit).toHaveBeenCalledWith(
+      expect.objectContaining({
+        linkageType: "HOSPITAL",
+        targetInstitution: "서울요양병원",
+        summary: "주간보호 이용 중 · 외래 진료 의",
+        status: "DRAFT"
+      })
+    );
+    expect(
+      await screen.findByText("연계기록지 초안을 저장했습니다.")
+    ).toBeInTheDocument();
+  });
+
+  it("disables dispatch when onDispatch is omitted", () => {
+    render(<ClientLinkageRecordForm onSubmit={vi.fn()} />);
+    expect(screen.getByRole("button", { name: "발송 확정" })).toBeDisabled();
+  });
+});
