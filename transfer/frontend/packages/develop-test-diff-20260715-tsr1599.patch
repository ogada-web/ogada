+    expect(
+      document.querySelector('time[dateTime="2026-07-11T01:30:00.000Z"]')
+    ).not.toBeNull();
+  });
+
+  it("shows empty state when there are no records", () => {
+    render(<ClientLinkageRecordsReportPanel records={[]} />);
+    expect(screen.getByText("연계기록지 없음")).toBeInTheDocument();
+  });
+
+  it("sets aria-busy while loading", () => {
+    const { container } = render(
+      <ClientLinkageRecordsReportPanel loading records={[]} />
+    );
+    expect(
+      container.querySelector('[aria-busy="true"]')
+    ).toBeInTheDocument();
+    expect(
+      screen.getByRole("status", { name: "연계기록지 목록 로딩 중" })
+    ).toBeInTheDocument();
+  });
+});
