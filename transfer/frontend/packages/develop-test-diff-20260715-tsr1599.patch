+import {
+  LINKAGE_RECORD_STATUS,
+  resolveLinkageTimestampParts,
+  resolveLinkageTypeLabel
+} from "../../config/linkageRecords";
+import Alert from "./Alert";
+import EmptyState from "./EmptyState";
+import Spinner from "./Spinner";
+import { StatusBadge } from "./Badge";
+import Table from "./Table";
+
+/**
+ * 연계기록지 발송 리포트 패널 셸 (US-CLIENT-LINKAGE-RECORD / G-LINKAGE-RECORD · 케어포 1-10).
+ * Client 스코프 목록(GET …/clients/{id}/linkage-records) 정규화 행을 표시.
+ *
+ * @param {{
+ *   records?: Array<object>,
+ *   loading?: boolean,
+ *   error?: string,
+ *   emptyMessage?: string,
+ *   className?: string,
+ * }} props
+ */
+function ClientLinkageRecordsReportPanel({
+  records = [],
+  loading = false,
+  error = "",
+  emptyMessage = "발송·작성된 연계기록지가 없습니다.",
+  className = ""
+}) {
+  const rows = Array.isArray(records) ? records : [];
+
+  return (
+    <section
+      className={["ds-stack", "ds-linkage-records-report", className]
+        .filter(Boolean)
+        .join(" ")}
+      aria-labelledby="linkage-records-report-heading"
+      aria-busy={loading || undefined}
+    >
+      <h3 id="linkage-records-report-heading">연계기록지 발송 리포트</h3>
+      <p className="ds-page-lede" role="note">
+        수급자별 연계기록지 작성·발송 이력을 조회합니다 (케어포 1-10 발송 리포트).
+      </p>
+
+      {error ? (
+        <Alert tone="danger" className="ds-page-alert" role="alert">
+          {error}
+        </Alert>
+      ) : null}
+
+      {loading ? <Spinner label="연계기록지 목록 로딩 중" /> : null}
+
+      {!loading && !error && rows.length === 0 ? (
+        <EmptyState title="연계기록지 없음" description={emptyMessage} />
+      ) : null}
+
+      {!loading && rows.length > 0 ? (
+        <Table caption="연계기록지 발송 이력" captionVisuallyHidden>
+          <thead>
+            <tr>
+              <th scope="col">수급자</th>
+              <th scope="col">연계 유형</th>
+              <th scope="col">대상 기관</th>
+              <th scope="col">작성일</th>
+              <th scope="col">발송 시각</th>
+              <th scope="col">상태</th>
+            </tr>
+          </thead>
+          <tbody>
+            {rows.map((row, index) => {
+              const recordParts = resolveLinkageTimestampParts(
+                row.recordDate || row.createdAt
+              );
+              const dispatchParts = resolveLinkageTimestampParts(row.dispatchedAt);
+              const recordDateOnly = recordParts.dateTime
+                ? recordParts.dateTime.slice(0, 10)
+                : null;
+              return (
+                <tr key={row.id || `linkage-${index}`}>
+                  <td>{row.clientName || row.clientId || "—"}</td>
+                  <td>{resolveLinkageTypeLabel(row.linkageType)}</td>
+                  <td>{row.targetInstitution || "—"}</td>
+                  <td>
+                    {recordDateOnly ? (
+                      <time dateTime={recordDateOnly}>{recordDateOnly}</time>
+                    ) : (
+                      recordParts.label
+                    )}
+                  </td>
+                  <td>
+                    {dispatchParts.dateTime ? (
+                      <time dateTime={dispatchParts.dateTime}>
+                        {dispatchParts.label}
+                      </time>
+                    ) : (
+                      dispatchParts.label
+                    )}
+                  </td>
+                  <td>
+                    <StatusBadge
+                      status={row.status || row.recordStatus || "DRAFT"}
+                      map={LINKAGE_RECORD_STATUS}
+                    />
+                  </td>
+                </tr>
+              );
+            })}
+          </tbody>
+        </Table>
+      ) : null}
+    </section>
+  );
+}
+
+export default ClientLinkageRecordsReportPanel;
