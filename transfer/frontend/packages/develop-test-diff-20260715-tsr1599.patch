diff --git a/src/components/clients/ClientLinkageRecordsPanel.jsx b/src/components/clients/ClientLinkageRecordsPanel.jsx
new file mode 100644
index 0000000..abaa43b
--- /dev/null
+++ b/src/components/clients/ClientLinkageRecordsPanel.jsx
@@ -0,0 +1,257 @@
+import { useCallback, useEffect, useState } from "react";
+import {
+  Alert,
+  Button,
+  Card,
+  ClientLinkageRecordForm,
+  ClientLinkageRecordsReportPanel,
+  Spinner,
+  StatusBadge
+} from "../ui";
+import { ApiError } from "../../api/http";
+import {
+  createClientLinkageRecordApi,
+  deleteClientLinkageRecordApi,
+  dispatchClientLinkageRecordApi,
+  fetchClientLinkageRecordsApi,
+  updateClientLinkageRecordApi
+} from "../../api/services";
+import {
+  LINKAGE_RECORD_STATUS,
+  buildLinkageRecordWritePayload,
+  normalizeLinkageRecord,
+  resolveLinkageTypeLabel
+} from "../../config/linkageRecords";
+
+/**
+ * G-LINKAGE-RECORD / carefor 1-10 — 연계기록지 작성·발송·이력 (ClientDetail 탭).
+ * BE: `/api/v1/clients/{clientId}/linkage-records` CRUD + dispatch.
+ */
+function ClientLinkageRecordsPanel({ clientId, clientName = "" }) {
+  const [records, setRecords] = useState([]);
+  const [loading, setLoading] = useState(false);
+  const [listError, setListError] = useState("");
+  const [actionError, setActionError] = useState("");
+  const [editing, setEditing] = useState(null);
+  const [formKey, setFormKey] = useState(0);
+  const [deletingId, setDeletingId] = useState("");
+  const [successMessage, setSuccessMessage] = useState("");
+
+  const load = useCallback(async () => {
+    if (!clientId) {
+      return;
+    }
+    setLoading(true);
+    setListError("");
+    try {
+      const page = await fetchClientLinkageRecordsApi(clientId, { size: 50 });
+      const items = Array.isArray(page?.items) ? page.items : [];
+      setRecords(
+        items
+          .map((item) => normalizeLinkageRecord(item, { clientName }))
+          .filter(Boolean)
+      );
+    } catch (err) {
+      setRecords([]);
+      setListError(
+        err instanceof ApiError
+          ? err.message
+          : "연계기록지 목록을 불러오지 못했습니다."
+      );
+    } finally {
+      setLoading(false);
+    }
+  }, [clientId, clientName]);
+
+  useEffect(() => {
+    load();
+  }, [load]);
+
+  function resetForm(nextEditing = null) {
+    setEditing(nextEditing);
+    setFormKey((key) => key + 1);
+    setActionError("");
+  }
+
+  async function handleSubmit(formPayload) {
+    if (!clientId) {
+      throw new Error("수급자를 선택하세요.");
+    }
+    const body = buildLinkageRecordWritePayload(formPayload);
+    setActionError("");
+    setSuccessMessage("");
+    try {
+      if (editing?.id && editing.status === "DRAFT") {
+        await updateClientLinkageRecordApi(clientId, editing.id, body);
+        setSuccessMessage("연계기록지 초안을 수정했습니다.");
+      } else {
+        await createClientLinkageRecordApi(clientId, body);
+        setSuccessMessage("연계기록지 초안을 저장했습니다.");
+      }
+      resetForm(null);
+      await load();
+    } catch (err) {
+      const message =
+        err instanceof ApiError ? err.message : "연계기록지 저장에 실패했습니다.";
+      setActionError(message);
+      throw err instanceof Error ? err : new Error(message);
+    }
+  }
+
+  async function handleDispatch(formPayload) {
+    if (!clientId) {
+      throw new Error("수급자를 선택하세요.");
+    }
+    const body = buildLinkageRecordWritePayload(formPayload);
+    setActionError("");
+    setSuccessMessage("");
+    try {
+      let recordId = editing?.id;
+      if (recordId && editing?.status === "DRAFT") {
+        await updateClientLinkageRecordApi(clientId, recordId, body);
+      } else {
+        const created = await createClientLinkageRecordApi(clientId, body);
+        recordId = created?.id;
+      }
+      if (!recordId) {
+        throw new Error("발송할 연계기록지 ID를 받지 못했습니다.");
+      }
+      await dispatchClientLinkageRecordApi(clientId, recordId);
+      setSuccessMessage("연계기록지를 발송 완료로 기록했습니다.");
+      resetForm(null);
+      await load();
+    } catch (err) {
+      const message =
+        err instanceof ApiError ? err.message : "연계기록지 발송에 실패했습니다.";
+      setActionError(message);
+      throw err instanceof Error ? err : new Error(message);
+    }
+  }
+
+  async function handleDeleteDraft(record) {
+    if (!clientId || !record?.id || record.status !== "DRAFT") {
+      return;
+    }
+    setDeletingId(record.id);
+    setActionError("");
+    try {
+      await deleteClientLinkageRecordApi(clientId, record.id);
+      if (editing?.id === record.id) {
+        resetForm(null);
+      }
+      await load();
+    } catch (err) {
+      setActionError(
+        err instanceof ApiError ? err.message : "초안 삭제에 실패했습니다."
+      );
+    } finally {
+      setDeletingId("");
+    }
+  }
+
+  const formInitialValues = editing
+    ? {
+        linkageType: editing.linkageType || "HOSPITAL",
+        targetInstitution: editing.targetInstitution || "",
+        recordDate: editing.recordDate || "",
+        summary: editing.summary || "",
+        carePlanAfterDischarge: "",
+        status: editing.status || "DRAFT"
+      }
+    : null;
+
+  return (
+    <div className="ds-stack">
+      <Card title="연계기록지 (케어포 1-10)">
+        <p className="ds-page-lede" role="note">
+          전원·퇴소 시 외부기관 연계기록지를 작성·발송하고 이력을 남깁니다
+          (평가지표 30 · US-CLIENT-LINKAGE-RECORD).
+        </p>
+        {actionError ? (
+          <Alert tone="danger" className="ds-page-alert" role="alert">
+            {actionError}
+          </Alert>
+        ) : null}
+        {successMessage ? (
+          <Alert tone="success" className="ds-page-alert" role="status">
+            {successMessage}
+          </Alert>
+        ) : null}
+        {editing ? (
+          <Alert tone="info" className="ds-page-alert" role="status">
+            초안 수정 중 — {resolveLinkageTypeLabel(editing.linkageType)} ·{" "}
+            {editing.targetInstitution || "기관 미입력"}
+            <Button
+              type="button"
+              variant="ghost"
+              className="ds-inline-action"
+              onClick={() => resetForm(null)}
+            >
+              새 초안으로
+            </Button>
+          </Alert>
+        ) : null}
+        <ClientLinkageRecordForm
+          key={formKey}
+          clientName={clientName}
+          initialValues={formInitialValues}
+          onSubmit={handleSubmit}
+          onDispatch={handleDispatch}
+        />
+      </Card>
+
+      <Card title="초안 관리">
+        {loading ? <Spinner label="연계기록지 목록 로딩 중" /> : null}
+        {!loading && records.some((row) => row.status === "DRAFT") ? (
+          <ul className="ds-list" aria-label="연계기록지 초안 목록">
+            {records
+              .filter((row) => row.status === "DRAFT")
+              .map((row) => (
+                <li key={row.id} className="ds-list__item ds-linkage-draft-row">
+                  <StatusBadge status="DRAFT" map={LINKAGE_RECORD_STATUS} />
+                  <span>
+                    {resolveLinkageTypeLabel(row.linkageType)} ·{" "}
+                    {row.targetInstitution || "—"}
+                  </span>
+                  <span className="ds-form-actions">
+                    <Button
+                      type="button"
+                      variant="secondary"
+                      onClick={() => resetForm(row)}
+                    >
+                      수정
+                    </Button>
+                    <Button
+                      type="button"
+                      variant="ghost"
+                      disabled={deletingId === row.id}
+                      aria-busy={deletingId === row.id || undefined}
+                      onClick={() => handleDeleteDraft(row)}
+                    >
+                      {deletingId === row.id ? (
+                        <Spinner label="삭제 중" size="sm" />
+                      ) : (
+                        "삭제"
+                      )}
+                    </Button>
+                  </span>
+                </li>
+              ))}
+          </ul>
+        ) : null}
+        {!loading && !records.some((row) => row.status === "DRAFT") ? (
+          <p className="ds-muted">수정·삭제 가능한 초안이 없습니다.</p>
+        ) : null}
+      </Card>
+
+      <ClientLinkageRecordsReportPanel
+        records={records}
+        loading={loading}
+        error={listError}
+        emptyMessage="이 수급자의 연계기록지가 없습니다. 위 양식에서 초안을 저장하세요."
+      />
+    </div>
+  );
+}
+
+export default ClientLinkageRecordsPanel;
