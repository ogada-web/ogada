diff --git a/src/config/linkageRecords.js b/src/config/linkageRecords.js
new file mode 100644
index 0000000..660cb2a
--- /dev/null
+++ b/src/config/linkageRecords.js
@@ -0,0 +1,127 @@
+/**
+ * 연계기록지(US-CLIENT-LINKAGE-RECORD / G-LINKAGE-RECORD · 케어포 1-10) 도메인 상수.
+ * BE `ClientLinkageRecordSupport` / V194 CHECK — HOSPITAL|HOME_CARE|TRANSFER only (OTHER 없음).
+ */
+
+export const LINKAGE_TYPE_OPTIONS = Object.freeze([
+  { value: "HOSPITAL", label: "병원·진료 의뢰" },
+  { value: "HOME_CARE", label: "재가·방문 연계" },
+  { value: "TRANSFER", label: "기관 이관" }
+]);
+
+export const LINKAGE_TYPE_LABELS = Object.freeze(
+  Object.fromEntries(LINKAGE_TYPE_OPTIONS.map((opt) => [opt.value, opt.label]))
+);
+
+/** StatusBadge map — 색+텍스트 병행 (WCAG 1.4.1) */
+export const LINKAGE_RECORD_STATUS = Object.freeze({
+  DRAFT: { tone: "neutral", label: "초안" },
+  DISPATCHED: { tone: "success", label: "발송 완료" }
+});
+
+export const LINKAGE_SUMMARY_MAX = 5000;
+export const LINKAGE_TARGET_INSTITUTION_MAX = 200;
+
+const CARE_PLAN_SECTION_MARKER = "[퇴소 후 이용계획]";
+
+/**
+ * @param {string|null|undefined} code
+ * @returns {string}
+ */
+export function resolveLinkageTypeLabel(code) {
+  if (!code) return "—";
+  return LINKAGE_TYPE_LABELS[code] || String(code);
+}
+
+/**
+ * @param {string|null|undefined} value
+ * @returns {{ dateTime: string|null, label: string }}
+ */
+export function resolveLinkageTimestampParts(value) {
+  if (!value) {
+    return { dateTime: null, label: "—" };
+  }
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) {
+    return { dateTime: null, label: String(value) };
+  }
+  return {
+    dateTime: date.toISOString(),
+    label: date.toLocaleString("ko-KR")
+  };
+}
+
+/**
+ * UX 폼 페이로드 → BE Create/Update body (`linkageType`·`targetInstitution`·`summary`만).
+ * 작성일·퇴소 후 이용계획은 summary에 포함해 V194 필드 계약에 맞춘다.
+ *
+ * @param {{
+ *   linkageType?: string,
+ *   targetInstitution?: string,
+ *   summary?: string,
+ *   recordDate?: string,
+ *   carePlanAfterDischarge?: string
+ * }} form
+ * @returns {{ linkageType: string, targetInstitution: string, summary: string }}
+ */
+export function buildLinkageRecordWritePayload(form = {}) {
+  const linkageType = String(form.linkageType || "").trim();
+  const targetInstitution = String(form.targetInstitution || "").trim();
+  const summaryParts = [];
+  const recordDate = String(form.recordDate || "").trim();
+  if (recordDate) {
+    summaryParts.push(`[작성일] ${recordDate}`);
+  }
+  const summaryCore = String(form.summary || "").trim();
+  if (summaryCore) {
+    summaryParts.push(summaryCore);
+  }
+  const carePlan = String(form.carePlanAfterDischarge || "").trim();
+  if (carePlan) {
+    summaryParts.push(`${CARE_PLAN_SECTION_MARKER}\n${carePlan}`);
+  }
+  let summary = summaryParts.join("\n\n");
+  if (summary.length > LINKAGE_SUMMARY_MAX) {
+    summary = summary.slice(0, LINKAGE_SUMMARY_MAX);
+  }
+  return {
+    linkageType,
+    targetInstitution: targetInstitution.slice(0, LINKAGE_TARGET_INSTITUTION_MAX),
+    summary
+  };
+}
+
+/**
+ * BE Response → 리포트/폼용 정규화 (`recordStatus` → `status`).
+ *
+ * @param {object|null|undefined} raw
+ * @param {{ clientName?: string }} [opts]
+ * @returns {object|null}
+ */
+export function normalizeLinkageRecord(raw, opts = {}) {
+  if (!raw || typeof raw !== "object") {
+    return null;
+  }
+  const createdAt = raw.createdAt || null;
+  const recordDate =
+    raw.recordDate ||
+    (typeof createdAt === "string" && createdAt.length >= 10
+      ? createdAt.slice(0, 10)
+      : null);
+  return {
+    id: raw.id ?? null,
+    clientId: raw.clientId ?? null,
+    branchId: raw.branchId ?? null,
+    clientName: opts.clientName || raw.clientName || null,
+    linkageType: raw.linkageType || null,
+    targetInstitution: raw.targetInstitution || "",
+    summary: raw.summary || "",
+    status: raw.recordStatus || raw.status || "DRAFT",
+    recordStatus: raw.recordStatus || raw.status || "DRAFT",
+    recordDate,
+    dispatchedAt: raw.dispatchedAt || null,
+    createdBy: raw.createdBy || null,
+    createdAt,
+    updatedAt: raw.updatedAt || null
+  };
+}
diff --git a/src/config/linkageRecords.test.js b/src/config/linkageRecords.test.js
new file mode 100644
index 0000000..4f1265b
--- /dev/null
+++ b/src/config/linkageRecords.test.js
@@ -0,0 +1,80 @@
+import { describe, expect, it } from "vitest";
+import {
+  LINKAGE_RECORD_STATUS,
+  LINKAGE_TYPE_OPTIONS,
+  buildLinkageRecordWritePayload,
+  normalizeLinkageRecord,
+  resolveLinkageTimestampParts,
+  resolveLinkageTypeLabel
+} from "./linkageRecords";
+
+describe("linkageRecords config (G-LINKAGE-RECORD)", () => {
+  it("exposes BE-aligned 3 linkage types (no OTHER)", () => {
+    expect(LINKAGE_TYPE_OPTIONS).toHaveLength(3);
+    expect(LINKAGE_TYPE_OPTIONS.map((o) => o.value)).toEqual([
+      "HOSPITAL",
+      "HOME_CARE",
+      "TRANSFER"
+    ]);
+    expect(resolveLinkageTypeLabel("HOSPITAL")).toBe("병원·진료 의뢰");
+    expect(resolveLinkageTypeLabel("TRANSFER")).toBe("기관 이관");
+    expect(resolveLinkageTypeLabel(null)).toBe("—");
+    expect(resolveLinkageTypeLabel("UNKNOWN")).toBe("UNKNOWN");
+  });
+
+  it("maps DRAFT/DISPATCHED status for StatusBadge (color+text)", () => {
+    expect(LINKAGE_RECORD_STATUS.DRAFT).toEqual({
+      tone: "neutral",
+      label: "초안"
+    });
+    expect(LINKAGE_RECORD_STATUS.DISPATCHED).toEqual({
+      tone: "success",
+      label: "발송 완료"
+    });
+  });
+
+  it("splits ISO timestamps for <time dateTime> wrapping", () => {
+    const parts = resolveLinkageTimestampParts("2026-07-15T04:00:00.000Z");
+    expect(parts.dateTime).toBe("2026-07-15T04:00:00.000Z");
+    expect(parts.label).toMatch(/2026/);
+    expect(resolveLinkageTimestampParts("")).toEqual({
+      dateTime: null,
+      label: "—"
+    });
+  });
+
+  it("builds BE write payload and folds care-plan into summary", () => {
+    const body = buildLinkageRecordWritePayload({
+      linkageType: "HOME_CARE",
+      targetInstitution: "재가센터",
+      recordDate: "2026-07-15",
+      summary: "심신기능 요약",
+      carePlanAfterDischarge: "주 2회 방문"
+    });
+    expect(body.linkageType).toBe("HOME_CARE");
+    expect(body.targetInstitution).toBe("재가센터");
+    expect(body.summary).toMatch(/\[작성일\] 2026-07-15/);
+    expect(body.summary).toContain("심신기능 요약");
+    expect(body.summary).toContain("[퇴소 후 이용계획]");
+    expect(body.summary).toContain("주 2회 방문");
+  });
+
+  it("normalizes BE recordStatus into UI status + recordDate", () => {
+    const row = normalizeLinkageRecord(
+      {
+        id: "lr1",
+        clientId: "c1",
+        linkageType: "HOSPITAL",
+        targetInstitution: "병원",
+        summary: "요약",
+        recordStatus: "DISPATCHED",
+        dispatchedAt: "2026-07-11T01:30:00.000Z",
+        createdAt: "2026-07-10T08:00:00.000Z"
+      },
+      { clientName: "홍길동" }
+    );
+    expect(row.status).toBe("DISPATCHED");
+    expect(row.recordDate).toBe("2026-07-10");
+    expect(row.clientName).toBe("홍길동");
+  });
+});
