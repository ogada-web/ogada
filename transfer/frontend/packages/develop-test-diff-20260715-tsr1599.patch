+import { beforeEach, describe, expect, it, vi } from "vitest";
+import * as http from "./http";
+import {
+  createClientLinkageRecordApi,
+  deleteClientLinkageRecordApi,
+  dispatchClientLinkageRecordApi,
+  fetchClientLinkageRecordApi,
+  fetchClientLinkageRecordsApi,
+  updateClientLinkageRecordApi
+} from "./services";
+
+describe("client linkage-records services (G-LINKAGE-RECORD)", () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it("fetchClientLinkageRecordsApi serializes filters", async () => {
+    vi.spyOn(http, "apiFetch").mockResolvedValue({
+      items: [],
+      page: 0,
+      size: 20,
+      totalElements: 0,
+      totalPages: 0
+    });
+    await fetchClientLinkageRecordsApi("client-1", {
+      status: "DRAFT",
+      q: "병원",
+      page: 1,
+      size: 20
+    });
+    expect(http.apiFetch).toHaveBeenCalledWith(
+      "/api/v1/clients/client-1/linkage-records?status=DRAFT&q=%EB%B3%91%EC%9B%90&page=1&size=20"
+    );
+  });
+
+  it("CRUD + dispatch use apiFetch with correct methods", async () => {
+    vi.spyOn(http, "apiFetch").mockResolvedValue({ id: "lr-1" });
+
+    await fetchClientLinkageRecordApi("c1", "lr-1");
+    expect(http.apiFetch).toHaveBeenCalledWith(
+      "/api/v1/clients/c1/linkage-records/lr-1"
+    );
+
+    await createClientLinkageRecordApi("c1", {
+      linkageType: "HOSPITAL",
+      targetInstitution: "서울병원",
+      summary: "의뢰"
+    });
+    expect(http.apiFetch).toHaveBeenCalledWith(
+      "/api/v1/clients/c1/linkage-records",
+      {
+        method: "POST",
+        body: JSON.stringify({
+          linkageType: "HOSPITAL",
+          targetInstitution: "서울병원",
+          summary: "의뢰"
+        })
+      }
+    );
+
+    await updateClientLinkageRecordApi("c1", "lr-1", {
+      linkageType: "TRANSFER",
+      targetInstitution: "인근센터",
+      summary: "이관"
+    });
+    expect(http.apiFetch).toHaveBeenCalledWith(
+      "/api/v1/clients/c1/linkage-records/lr-1",
+      {
+        method: "PATCH",
+        body: JSON.stringify({
+          linkageType: "TRANSFER",
+          targetInstitution: "인근센터",
+          summary: "이관"
+        })
+      }
+    );
+
+    await dispatchClientLinkageRecordApi("c1", "lr-1");
+    expect(http.apiFetch).toHaveBeenCalledWith(
+      "/api/v1/clients/c1/linkage-records/lr-1/dispatch",
+      { method: "POST" }
+    );
+
+    await deleteClientLinkageRecordApi("c1", "lr-1");
+    expect(http.apiFetch).toHaveBeenCalledWith(
+      "/api/v1/clients/c1/linkage-records/lr-1",
+      { method: "DELETE" }
+    );
+  });
+});
