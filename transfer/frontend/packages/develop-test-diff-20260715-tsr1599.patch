+import { useId, useState } from "react";
+import {
+  LINKAGE_RECORD_STATUS,
+  LINKAGE_TYPE_OPTIONS
+} from "../../config/linkageRecords";
+import Alert from "./Alert";
+import Button from "./Button";
+import DateInput from "./DateInput";
+import Field from "./Field";
+import Select from "./Select";
+import Spinner from "./Spinner";
+import { StatusBadge } from "./Badge";
+import TextInput from "./TextInput";
+import Textarea from "./Textarea";
+
+function currentDateString() {
+  const now = new Date();
+  const year = now.getFullYear();
+  const month = String(now.getMonth() + 1).padStart(2, "0");
+  const day = String(now.getDate()).padStart(2, "0");
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * 연계기록지 작성 폼 (US-CLIENT-LINKAGE-RECORD / G-LINKAGE-RECORD · 케어포 1-10).
+ * onSubmit/onDispatch 페이로드는 UX 필드 포함 — 패널이 `buildLinkageRecordWritePayload`로 BE body 변환.
+ *
+ * @param {{
+ *   clientName?: string,
+ *   initialValues?: object|null,
+ *   onSubmit?: (payload: object) => Promise<void>|void,
+ *   onDispatch?: (payload: object) => Promise<void>|void,
+ *   disabled?: boolean,
+ *   className?: string,
+ * }} props
+ */
+function ClientLinkageRecordForm({
+  clientName = "",
+  initialValues = null,
+  onSubmit,
+  onDispatch,
+  disabled = false,
+  className = ""
+}) {
+  const headingId = useId();
+  const [linkageType, setLinkageType] = useState(
+    initialValues?.linkageType || "HOSPITAL"
+  );
+  const [targetInstitution, setTargetInstitution] = useState(
+    initialValues?.targetInstitution || ""
+  );
+  const [recordDate, setRecordDate] = useState(
+    initialValues?.recordDate || currentDateString()
+  );
+  const [summary, setSummary] = useState(initialValues?.summary || "");
+  const [carePlanAfterDischarge, setCarePlanAfterDischarge] = useState(
+    initialValues?.carePlanAfterDischarge || ""
+  );
+  const [status, setStatus] = useState(
+    initialValues?.status || initialValues?.recordStatus || "DRAFT"
+  );
+  const [submitting, setSubmitting] = useState(false);
+  const [dispatching, setDispatching] = useState(false);
+  const [error, setError] = useState("");
+  const [fieldErrors, setFieldErrors] = useState({});
+  const [successMessage, setSuccessMessage] = useState("");
+
+  const busy = submitting || dispatching || disabled || status === "DISPATCHED";
+
+  function validate() {
+    const next = {};
+    if (!linkageType) {
+      next.linkageType = "연계 유형을 선택하세요.";
+    }
+    if (!targetInstitution.trim()) {
+      next.targetInstitution = "연계 대상 기관명을 입력하세요.";
+    }
+    if (!recordDate) {
+      next.recordDate = "작성일을 입력하세요.";
+    }
+    if (!summary.trim()) {
+      next.summary = "심신기능·제공 급여 요약을 입력하세요.";
+    }
+    return next;
+  }
+
+  function buildPayload() {
+    return {
+      linkageType,
+      targetInstitution: targetInstitution.trim(),
+      recordDate,
+      summary: summary.trim(),
+      carePlanAfterDischarge: carePlanAfterDischarge.trim(),
+      status
+    };
+  }
+
+  async function handleSave(event) {
+    event.preventDefault();
+    const nextErrors = validate();
+    if (Object.keys(nextErrors).length) {
+      setFieldErrors(nextErrors);
+      setSuccessMessage("");
+      return;
+    }
+    setFieldErrors({});
+    setError("");
+    setSuccessMessage("");
+    setSubmitting(true);
+    try {
+      await onSubmit?.(buildPayload());
+      setStatus("DRAFT");
+      setSuccessMessage("연계기록지 초안을 저장했습니다.");
+    } catch (err) {
+      setError(err?.message || "연계기록지 저장에 실패했습니다.");
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  async function handleDispatch() {
+    const nextErrors = validate();
+    if (Object.keys(nextErrors).length) {
+      setFieldErrors(nextErrors);
+      setSuccessMessage("");
+      return;
+    }
+    setFieldErrors({});
+    setError("");
+    setSuccessMessage("");
+    setDispatching(true);
+    try {
+      await onDispatch?.(buildPayload());
+      setStatus("DISPATCHED");
+      setSuccessMessage("연계기록지를 발송 완료로 기록했습니다.");
+    } catch (err) {
+      setError(err?.message || "연계기록지 발송에 실패했습니다.");
+    } finally {
+      setDispatching(false);
+    }
+  }
+
+  return (
+    <section
+      className={["ds-stack", "ds-linkage-record-form", className]
+        .filter(Boolean)
+        .join(" ")}
+      aria-labelledby={headingId}
+    >
+      <div className="ds-linkage-record-form__header">
+        <h3 id={headingId}>
+          연계기록지 작성
+          {clientName ? ` — ${clientName}` : ""}
+        </h3>
+        <StatusBadge status={status} map={LINKAGE_RECORD_STATUS} />
+      </div>
+
+      <p className="ds-page-lede" role="note">
+        병원 의뢰·재가 연계·기관 이관 시 외부기관 연계기록지를 작성·발송합니다
+        (케어포 1-10 · 평가지표 30 · DRAFT→DISPATCHED).
+      </p>
+
+      {error ? (
+        <Alert tone="danger" className="ds-page-alert" role="alert">
+          {error}
+        </Alert>
+      ) : null}
+      {successMessage ? (
+        <Alert tone="success" className="ds-page-alert" role="status">
+          {successMessage}
+        </Alert>
+      ) : null}
+
+      <form
+        className="ds-form-grid"
+        aria-label="연계기록지 작성"
+        onSubmit={handleSave}
+        noValidate
+      >
+        <Field
+          htmlFor="linkage-record-type"
+          label="연계 유형"
+          error={fieldErrors.linkageType}
+          required
+        >
+          {(p) => (
+            <Select
+              {...p}
+              value={linkageType}
+              onChange={(event) => {
+                setLinkageType(event.target.value);
+                setFieldErrors((prev) => {
+                  const next = { ...prev };
+                  delete next.linkageType;
+                  return next;
+                });
+              }}
+              disabled={busy}
+            >
+              {LINKAGE_TYPE_OPTIONS.map((opt) => (
+                <option key={opt.value} value={opt.value}>
+                  {opt.label}
+                </option>
+              ))}
+            </Select>
+          )}
+        </Field>
+
+        <Field
+          htmlFor="linkage-record-institution"
+          label="연계 대상 기관"
+          error={fieldErrors.targetInstitution}
+          required
+        >
+          {(p) => (
+            <TextInput
+              {...p}
+              value={targetInstitution}
+              onChange={(event) => {
+                setTargetInstitution(event.target.value);
+                setFieldErrors((prev) => {
+                  const next = { ...prev };
+                  delete next.targetInstitution;
+                  return next;
+                });
+              }}
+              disabled={busy}
+              autoComplete="organization"
+            />
+          )}
+        </Field>
+
+        <Field
+          htmlFor="linkage-record-date"
+          label="작성일"
+          error={fieldErrors.recordDate}
+          required
+        >
+          {(p) => (
+            <DateInput
+              {...p}
+              value={recordDate}
+              onChange={(event) => {
+                setRecordDate(event.target.value);
+                setFieldErrors((prev) => {
+                  const next = { ...prev };
+                  delete next.recordDate;
+                  return next;
+                });
+              }}
+              disabled={busy}
+            />
+          )}
+        </Field>
+
+        <Field
+          htmlFor="linkage-record-summary"
+          label="심신기능·제공 급여 요약"
+          error={fieldErrors.summary}
+          required
+          className="ds-form-grid__full"
+        >
+          {(p) => (
+            <Textarea
+              {...p}
+              rows={4}
+              value={summary}
+              onChange={(event) => {
+                setSummary(event.target.value);
+                setFieldErrors((prev) => {
+                  const next = { ...prev };
+                  delete next.summary;
+                  return next;
+                });
+              }}
+              disabled={busy}
+            />
+          )}
+        </Field>
+
+        <Field
+          htmlFor="linkage-record-care-plan"
+          label="퇴소 후 이용계획"
+          help="전원·퇴소 시 향후 이용·연계 계획을 적습니다."
+          className="ds-form-grid__full"
+        >
+          {(p) => (
+            <Textarea
+              {...p}
+              rows={3}
+              value={carePlanAfterDischarge}
+              onChange={(event) => setCarePlanAfterDischarge(event.target.value)}
+              disabled={busy}
+            />
+          )}
+        </Field>
+
+        <div className="ds-form-actions ds-form-grid__full">
+          <Button type="submit" variant="primary" disabled={busy} aria-busy={submitting}>
+            {submitting ? <Spinner label="저장 중" size="sm" /> : "초안 저장"}
+          </Button>
+          <Button
+            type="button"
+            variant="secondary"
+            disabled={busy || !onDispatch}
+            aria-busy={dispatching}
+            onClick={handleDispatch}
+          >
+            {dispatching ? <Spinner label="발송 중" size="sm" /> : "발송 확정"}
+          </Button>
+        </div>
+      </form>
+    </section>
+  );
+}
+
+export default ClientLinkageRecordForm;
