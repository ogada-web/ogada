+import { render, screen, waitFor, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import * as services from "../../api/services";
+import ClientLinkageRecordsPanel from "./ClientLinkageRecordsPanel";
+
+vi.mock("../../api/services", async () => {
+  const actual = await vi.importActual("../../api/services");
+  return {
+    ...actual,
+    fetchClientLinkageRecordsApi: vi.fn(),
+    createClientLinkageRecordApi: vi.fn(),
+    updateClientLinkageRecordApi: vi.fn(),
+    dispatchClientLinkageRecordApi: vi.fn(),
+    deleteClientLinkageRecordApi: vi.fn()
+  };
+});
+
+describe("ClientLinkageRecordsPanel (G-LINKAGE-RECORD wire)", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    services.fetchClientLinkageRecordsApi.mockResolvedValue({
+      items: [
+        {
+          id: "lr-dispatched",
+          clientId: "c1",
+          linkageType: "TRANSFER",
+          targetInstitution: "인근주간보호",
+          summary: "이관 요약",
+          recordStatus: "DISPATCHED",
+          dispatchedAt: "2026-07-11T01:30:00.000Z",
+          createdAt: "2026-07-10T00:00:00.000Z"
+        }
+      ],
+      page: 0,
+      size: 50,
+      totalElements: 1,
+      totalPages: 1
+    });
+  });
+
+  it("loads report rows and creates a draft via API", async () => {
+    const user = userEvent.setup();
+    services.createClientLinkageRecordApi.mockResolvedValue({
+      id: "lr-new",
+      recordStatus: "DRAFT"
+    });
+    services.fetchClientLinkageRecordsApi
+      .mockResolvedValueOnce({
+        items: [],
+        page: 0,
+        size: 50,
+        totalElements: 0,
+        totalPages: 0
+      })
+      .mockResolvedValueOnce({
+        items: [
+          {
+            id: "lr-new",
+            clientId: "c1",
+            linkageType: "HOSPITAL",
+            targetInstitution: "서울요양병원",
+            summary: "외래 의뢰",
+            recordStatus: "DRAFT",
+            createdAt: "2026-07-15T01:00:00.000Z"
+          }
+        ],
+        page: 0,
+        size: 50,
+        totalElements: 1,
+        totalPages: 1
+      });
+
+    render(<ClientLinkageRecordsPanel clientId="c1" clientName="홍길동" />);
+
+    await waitFor(() => {
+      expect(services.fetchClientLinkageRecordsApi).toHaveBeenCalledWith("c1", {
+        size: 50
+      });
+    });
+
+    await user.type(screen.getByLabelText(/연계 대상 기관/), "서울요양병원");
+    await user.type(screen.getByLabelText(/심신기능·제공 급여 요약/), "외래 의뢰");
+    await user.click(screen.getByRole("button", { name: "초안 저장" }));
+
+    await waitFor(() => {
+      expect(services.createClientLinkageRecordApi).toHaveBeenCalledWith(
+        "c1",
+        expect.objectContaining({
+          linkageType: "HOSPITAL",
+          targetInstitution: "서울요양병원",
+          summary: expect.stringContaining("외래 의뢰")
+        })
+      );
+    });
+
+    expect(
+      await screen.findByText("연계기록지 초안을 저장했습니다.")
+    ).toBeInTheDocument();
+  });
+
+  it("creates then dispatches on 발송 확정", async () => {
+    const user = userEvent.setup();
+    services.fetchClientLinkageRecordsApi.mockResolvedValue({
+      items: [],
+      page: 0,
+      size: 50,
+      totalElements: 0,
+      totalPages: 0
+    });
+    services.createClientLinkageRecordApi.mockResolvedValue({
+      id: "lr-2",
+      recordStatus: "DRAFT"
+    });
+    services.dispatchClientLinkageRecordApi.mockResolvedValue({
+      id: "lr-2",
+      recordStatus: "DISPATCHED"
+    });
+
+    render(<ClientLinkageRecordsPanel clientId="c1" clientName="홍길동" />);
+
+    await waitFor(() => {
+      expect(services.fetchClientLinkageRecordsApi).toHaveBeenCalled();
+    });
+
+    await user.type(screen.getByLabelText(/연계 대상 기관/), "재가센터A");
+    await user.type(screen.getByLabelText(/심신기능·제공 급여 요약/), "방문요양 연계");
+    await user.click(screen.getByRole("button", { name: "발송 확정" }));
+
+    await waitFor(() => {
+      expect(services.createClientLinkageRecordApi).toHaveBeenCalled();
+      expect(services.dispatchClientLinkageRecordApi).toHaveBeenCalledWith(
+        "c1",
+        "lr-2"
+      );
+    });
+
+    expect(
+      await screen.findByText("연계기록지를 발송 완료로 기록했습니다.")
+    ).toBeInTheDocument();
+  });
+
+  it("maps BE recordStatus into the report table", async () => {
+    render(<ClientLinkageRecordsPanel clientId="c1" clientName="김수급" />);
+
+    const table = await screen.findByRole("table", {
+      name: "연계기록지 발송 이력"
+    });
+    expect(within(table).getByText("김수급")).toBeInTheDocument();
+    expect(within(table).getByText("기관 이관")).toBeInTheDocument();
+    expect(within(table).getByText("발송 완료")).toBeInTheDocument();
+  });
+});
